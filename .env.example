# Salin jadi .env terus sesuaikan. Semua opsional — kalau kosong, dipakai default di agent/config.py.

# --- Hotkey ---
# PAKAI TOMBOL TUNGGAL. Tombol yang ditahan bareng modifier bikin Windows ngirim
# UP/DOWN palsu terus-terusan, rekamannya jadi kepotong-potong. Lihat README.
# Contoh bagus: right ctrl, f8, right shift. Bisa juga generik: ctrl, alt.
HOTKEY=right ctrl
# toggle = pencet sekali mulai, pencet lagi berhenti
# hold   = tahan selama ngomong (push-to-talk)
HOTKEY_MODE=toggle
# Backend hotkey:
#   pynput   - default, jalan tanpa admin
#   keyboard - bisa nge-suppress hotkey, tapi butuh admin dan di sebagian mesin nggak jalan
HOTKEY_BACKEND=pynput
# Telen hotkey biar nggak nyasar jadi ketikan di app yang lagi fokus (backend "keyboard" doang)
HOTKEY_SUPPRESS=true

# --- Otak ---
# claude = Claude API (lebih pintar & cepet, butuh internet + kunci berbayar)
# ollama = model lokal (gratis, jalan offline, lebih lemot)
LLM_BACKEND=claude

# --- Claude API (kalau LLM_BACKEND=claude) ---
# Ambil kunci di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
# low/medium/high/xhigh/max — buat obrolan pendek, "low" paling responsif
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT=60

# --- Ollama (kalau LLM_BACKEND=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- Whisper (STT) ---
# tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# cpu atau cuda
WHISPER_DEVICE=cpu
# int8 (cpu) / float16 (cuda)
WHISPER_COMPUTE=int8
WHISPER_LANG=id
# Lepas model dari VRAM kalau nganggur selama ini (detik). 0 = nggak pernah.
# Membebasin ~1.9 GB VRAM pas kamu nggak lagi ngobrol; bayarannya ~4 detik muat
# ulang di pertanyaan pertama setelah nganggur lama.
WHISPER_IDLE_UNLOAD_SECONDS=900

# --- Piper (TTS) ---
# Path relatif ke root repo, atau absolut
PIPER_VOICE=models/id_ID-news_tts-medium.onnx

# --- Audio ---
SAMPLE_RATE=16000
# Rekaman lebih pendek dari ini dianggap salah pencet (detik)
MIN_RECORD_SECONDS=0.4
# Tenggang sebelum rekaman distop pas hotkey kedeteksi lepas. Windows sering ngirim
# UP/DOWN palsu selama tombol ditahan; naikin kalau rekaman masih kepotong-potong.
RELEASE_GRACE_SECONDS=0.6
# Bantalan hening di kedua ujung playback. Tanpa ini Windows motong ~100 ms di
# awal & akhir tiap suara. Naikin kalau masih kepotong di mesinmu.
PLAYBACK_PAD_SECONDS=0.2

# --- Log ---
LOG_FILE=logs/agent.log
LOG_LEVEL=INFO
# Simpan tiap rekaman mic ke logs/rec/*.wav buat nyetel akurasi STT.
# Matiin lagi kalau udah selesai — ini nyimpen rekaman suaramu ke disk.
SAVE_RECORDINGS=false
