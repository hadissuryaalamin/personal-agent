# Copy to .env and adjust. Everything is optional — anything left out falls back
# to the default in agent/config.py.
# The settings below run entirely locally, with no network at all.

# --- Language & mode ---
# Selects the prompt and the models. Only "en" is supported.
LANGUAGE=en
# Which wall clock "today" and "tomorrow" mean in the event store.
TIMEZONE=Australia/Canberra
# When true, backends that need the internet are REJECTED at startup rather than
# left to fail quietly once you have already asked something.
# Currently affects: LLM_BACKEND=claude.
OFFLINE_MODE=true

# --- Hotkey ---
# USE A SINGLE KEY. A key held together with a modifier makes Windows send
# spurious UP/DOWN pairs, which shatters the recording. See the README.
# Good choices: right ctrl, f8, right shift. Generic also works: ctrl, alt.
HOTKEY=right ctrl
# toggle = press once to start, press again to stop
# hold   = hold the key while speaking (push-to-talk)
# Ignored when SESSION_MODE=true.
HOTKEY_MODE=toggle
# Hotkey backend:
#   pynput   - default, works without admin
#   keyboard - can suppress the hotkey, but needs admin and does not dispatch
#              at all on some machines
HOTKEY_BACKEND=pynput
# Swallow the hotkey so it does not leak into the focused app ("keyboard" only)
HOTKEY_SUPPRESS=true

# --- Session mode (continuous conversation) ---
# true = press the hotkey once to ENTER A SESSION, then talk back and forth
# without pressing again. Utterance boundaries come from the VAD (Silero), not
# the key.
# Closing a session: press the hotkey again, stay silent for
# SESSION_IDLE_SECONDS, or say "goodbye" / "that's all" / "stop listening".
SESSION_MODE=false
# The session closes itself after this many seconds of silence. Not optional:
# without it, forgetting to close means models sit in memory all day.
SESSION_IDLE_SECONDS=30
# Minimum probability for a frame to count as speech (0..1). Raise it if room
# noise reads as talking; lower it if quiet speech gets missed.
VAD_THRESHOLD=0.5
# Silence for this long ends your sentence. Too short and sentences split at
# natural pauses; too long and the agent feels slow to answer.
VAD_SILENCE_MS=800
# Sounds shorter than this are ignored — coughs, key taps, tongue clicks.
VAD_MIN_SPEECH_MS=250
# Audio kept from before speech is detected. The VAD is always slightly late to
# recognise a word onset; without this the first consonant is clipped.
VAD_SPEECH_PAD_MS=300

# --- Tools ---
# Let the model ask for your real schedule instead of answering from memory.
# Measured on qwen2.5:7b: 30/30 questions that should call a tool did, 0/10
# that should not. Turn off to make the agent talk-only again.
TOOLS_ENABLED=true
# A turn may need several rounds (read the schedule, then save something based
# on it). Bounded so a model stuck asking for the same tool cannot loop.
TOOL_MAX_ROUNDS=3

# --- Brain ---
# ollama = local model (free, offline, ~2-4 s per answer)
# claude = Claude API (smarter, needs internet + a paid key)
#          -> must be paired with OFFLINE_MODE=false
LLM_BACKEND=ollama

# --- Ollama (when LLM_BACKEND=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
# Safety net on reply length. Every stray token becomes ~0.4 s of audio you have
# to sit through.
OLLAMA_NUM_PREDICT=160
# Ollama defaults to 4096 when not asked.
OLLAMA_NUM_CTX=8192
# How many conversation turns are carried into the next request. History only
# lives as long as the process — a restart starts clean.
MAX_HISTORY_MESSAGES=20

# A word limit appended to the system prompt. Different from OLLAMA_NUM_PREDICT:
# that cuts mid-word, this makes the model stop on its own.
# Measured on qwen2.5:7b: 41 words down to 17, audio 18.4 s down to 9.3 s.
# It matters most in session mode — without barge-in, a long reply cannot be cut
# short. 0 = off.
REPLY_MAX_WORDS=25

# --- Claude API (when LLM_BACKEND=claude) ---
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# Alternative if you use an OAuth token rather than a plain API key:
# ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5
# low/medium/high/xhigh/max — for short exchanges, "low" is the most responsive
CLAUDE_EFFORT=low
# disabled / adaptive / empty. Sonnet 5 and Opus 5 turn thinking ON when the
# parameter is omitted, and max_tokens then covers the thoughts too.
CLAUDE_THINKING=disabled
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT=60

# --- STT ---
# parakeet = NVIDIA Parakeet TDT 0.6B v2 via onnx-asr. CPU, ZERO VRAM,
#            ~0.4 s per sentence, English only.
# whisper  = faster-whisper. Multilingual, but wants ~2 GB VRAM on GPU.
STT_BACKEND=parakeet
STT_MODEL=nemo-parakeet-tdt-0.6b-v2
# cpu or cuda. Parakeet is deliberately on CPU: zero VRAM, and the 8 GB GPU is
# already taken by qwen. The difference is only ~0.2 s.
STT_DEVICE=cpu

# --- Whisper (only used when STT_BACKEND=whisper) ---
# tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# int8 (cpu) / float16 (cuda)
WHISPER_COMPUTE=int8
WHISPER_LANG=en
# Vocabulary you use often. Whisper biases its guesses toward these words at no
# runtime cost. Parakeet accepts no prompt. The default lives in
# agent/config.py — only set this if you want to change it.
# WHISPER_PROMPT=
# Release the model from memory after this many idle seconds. 0 = never.
WHISPER_IDLE_UNLOAD_SECONDS=900
# Load the model at startup. Defaults to following the line above: off when idle
# release is on, on when it is off. Set it explicitly to force the choice.
# WHISPER_WARMUP=false

# --- TTS ---
# kokoro = Kokoro-82M via kokoro-onnx. 24 kHz, 54 voices, CPU, zero VRAM.
# piper  = Piper. Lighter, lower quality.
TTS_BACKEND=kokoro
KOKORO_MODEL=models/kokoro-v1.0.onnx
KOKORO_VOICES=models/voices-v1.0.bin
# The full list is printed to the log if the voice name is wrong.
KOKORO_VOICE=af_heart
KOKORO_LANG=en-us
# 1.0 = natural speed. Raise it to get through answers faster.
KOKORO_SPEED=1.0

# --- Piper (only used when TTS_BACKEND=piper) ---
# PIPER_VOICE=models/en_US-lessac-medium.onnx

# --- Audio ---
SAMPLE_RATE=16000
# Recordings shorter than this count as a stray press (seconds)
MIN_RECORD_SECONDS=0.4
# Upper bound, so an accidentally stuck hotkey cannot record forever
MAX_RECORD_SECONDS=60
# Grace period before recording stops once the hotkey reads as released. Windows
# often sends spurious UP/DOWN pairs while a key is held; raise this if
# recordings still come out fragmented.
RELEASE_GRACE_SECONDS=0.6
# Silence padding at both ends of playback. Without it Windows clips ~100 ms off
# the start and end of every sound. Raise it if yours still gets clipped.
PLAYBACK_PAD_SECONDS=0.2

# --- Misc ---
# Where agent.lock (the single-instance lock) is kept
MEMORY_DIR=memory

# --- Logging ---
LOG_FILE=logs/agent.log
LOG_LEVEL=INFO
# Save every mic recording to logs/rec/*.wav for tuning STT accuracy.
# Turn it off when you are done — this stores your voice on disk.
SAVE_RECORDINGS=false
RECORDINGS_DIR=logs/rec

# --- Probe and prefill ---
# Start the service first:
#   .\.venv-probe\Scripts\python.exe -m src.probe_service
# If it is not running the agent falls back to prompt-only tool routing.
# Only for LLM_BACKEND=ollama, where the probe needs a service of its own
# (src/probe_service.py) because the model that reads is not the model that
# answers. With LLM_BACKEND=hf the probe lives inside src/hf_service.py and
# this does nothing.
PROBE_ENABLED=true
PROBE_URL=http://127.0.0.1:11500
PROBE_TAU=0.5
PROBE_TIMEOUT=5

# Tray icon in the notification area
TRAY_ENABLED=true
