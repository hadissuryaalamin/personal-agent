# Salin jadi .env terus sesuaikan. Semua opsional — kalau kosong, dipakai default di agent/config.py.
# Setelan bawaan di bawah ini = jalan sepenuhnya lokal, tanpa jaringan sama sekali.

# --- Bahasa & mode ---
# Nentuin pengurai tanggal, kata kunci niat, dan prompt. Cuma "en" yang didukung
# penuh; pengurai Indonesia masih ada di agent/waktu_id.py tapi nggak dipakai.
LANGUAGE=en
# Kalau true, setelan yang butuh internet DITOLAK pas startup — bukan dibiarin
# gagal diam-diam pas kamu udah nanya. Yang kena: LLM_BACKEND=claude,
# CALENDAR_ICS_URL, GOOGLE_CREDENTIALS_FILE.
OFFLINE_MODE=true

# --- Hotkey ---
# PAKAI TOMBOL TUNGGAL. Tombol yang ditahan bareng modifier bikin Windows ngirim
# UP/DOWN palsu terus-terusan, rekamannya jadi kepotong-potong. Lihat README.
# Contoh bagus: right ctrl, f8, right shift. Bisa juga generik: ctrl, alt.
HOTKEY=right ctrl
# toggle = pencet sekali mulai, pencet lagi berhenti
# hold   = tahan selama ngomong (push-to-talk)
# Diabaikan kalau SESSION_MODE=true.
HOTKEY_MODE=toggle

# --- Mode sesi (ngobrol kontinu) ---
# true = sekali pencet hotkey buat MASUK SESI, terus ngomong bolak-balik tanpa
# mencet lagi. Batas kalimat dideteksi VAD (Silero), bukan tombol.
# Nutup sesi: pencet hotkey lagi, diam SESSION_IDLE_SECONDS, atau bilang
# "goodbye" / "that's all" / "stop listening".
SESSION_MODE=false
# Sesi nutup sendiri kalau sekian detik nggak ada suara. Wajib ada: tanpa ini,
# lupa nutup berarti model nyangkut di memori seharian.
SESSION_IDLE_SECONDS=30
# Peluang minimum sebuah frame dianggap suara (0..1). Naikin kalau kebisingan
# ruangan kebaca sebagai omongan; turunin kalau suara pelanmu nggak ketangkep.
VAD_THRESHOLD=0.5
# Sepi selama ini = kalimatmu dianggap selesai. Kekecilan bikin kalimat kepotong
# di jeda alami; kegedean bikin agent kerasa lelet nyaut.
VAD_SILENCE_MS=800
# Suara lebih pendek dari ini diabaikan — batuk, ketukan keyboard, decak.
VAD_MIN_SPEECH_MS=250
# Audio sebelum suara kedeteksi yang tetap disimpen. VAD selalu telat sedikit
# ngenalin awal kata; tanpa ini konsonan pertama kepotong.
VAD_SPEECH_PAD_MS=300
# Backend hotkey:
#   pynput   - default, jalan tanpa admin
#   keyboard - bisa nge-suppress hotkey, tapi butuh admin dan di sebagian mesin nggak jalan
HOTKEY_BACKEND=pynput
# Telen hotkey biar nggak nyasar jadi ketikan di app yang lagi fokus (backend "keyboard" doang)
HOTKEY_SUPPRESS=true

# --- Otak ---
# ollama = model lokal (gratis, offline, ~2-4 detik per jawaban)
# claude = Claude API (lebih pintar, butuh internet + kunci berbayar)
#          -> harus barengan OFFLINE_MODE=false
LLM_BACKEND=ollama

# --- Ollama (kalau LLM_BACKEND=ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
# Jaring pengaman panjang balasan. Tiap token nyangkut jadi ~0.4 detik audio
# yang harus didengerin sampai habis.
OLLAMA_NUM_PREDICT=160
# Ollama defaultnya 4096 kalau nggak diminta. System prompt aja udah ~850 token
# (jadwal + fakta), jadi sisanya kepakai riwayat beberapa giliran doang.
OLLAMA_NUM_CTX=8192

# Batas kata yang ditempel ke system prompt. Beda dari OLLAMA_NUM_PREDICT: itu
# motong paksa di tengah kata, ini bikin modelnya sendiri yang ngerem.
# Terukur di qwen2.5:7b: 41 kata jadi 17, audio 18,4 detik jadi 9,3. Penting
# banget di mode sesi — tanpa barge-in, balasan panjang nggak bisa dipotong.
# 0 = matiin.
REPLY_MAX_WORDS=25

# --- Claude API (kalau LLM_BACKEND=claude) ---
# Ambil kunci di https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# Alternatif kalau kamu pakai token OAuth, bukan kunci API biasa:
# ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5
# low/medium/high/xhigh/max — buat obrolan pendek, "low" paling responsif
CLAUDE_EFFORT=low
# disabled / adaptive / kosong. Sonnet 5 & Opus 5 NYALAIN thinking kalau
# parameternya nggak dikirim, dan max_tokens kebagi sama isi pikirannya.
CLAUDE_THINKING=disabled
CLAUDE_MAX_TOKENS=1024
CLAUDE_TIMEOUT=60

# --- STT ---
# parakeet = NVIDIA Parakeet TDT 0.6B v2 lewat onnx-asr. CPU, NOL VRAM,
#            ~0.4 detik per kalimat, Inggris aja.
# whisper  = faster-whisper. Multibahasa, tapi makan ~2 GB VRAM di GPU.
STT_BACKEND=parakeet
STT_MODEL=nemo-parakeet-tdt-0.6b-v2
# cpu atau cuda. Parakeet sengaja di CPU: nol VRAM, dan GPU 8 GB udah kepakai
# qwen. Bedanya cuma ~0.2 detik.
STT_DEVICE=cpu

# --- Whisper (cuma kepakai kalau STT_BACKEND=whisper) ---
# tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# int8 (cpu) / float16 (cuda)
WHISPER_COMPUTE=int8
WHISPER_LANG=en
# Kosakata yang sering kepakai. Whisper mencondongkan tebakannya ke kata-kata
# di sini, nol biaya waktu proses. Parakeet nggak nerima prompt. Default-nya
# ada di agent/config.py — isi di sini cuma kalau mau ganti.
# WHISPER_PROMPT=
# Lepas model dari memori kalau nganggur selama ini (detik). 0 = nggak pernah.
WHISPER_IDLE_UNLOAD_SECONDS=900
# Muat model pas agent nyala. Default ngikutin baris di atas: mati kalau
# pelepasan idle nyala, nyala kalau nggak. Isi manual buat maksa.
# WHISPER_WARMUP=false

# --- TTS ---
# kokoro = Kokoro-82M lewat kokoro-onnx. 24 kHz, 54 suara, CPU, nol VRAM.
# piper  = Piper. Lebih ringan, kualitas di bawahnya.
TTS_BACKEND=kokoro
KOKORO_MODEL=models/kokoro-v1.0.onnx
KOKORO_VOICES=models/voices-v1.0.bin
# Daftar lengkap ada di log kalau nama suaranya salah.
KOKORO_VOICE=af_heart
KOKORO_LANG=en-us
# 1.0 = kecepatan asli. Naikin buat jawaban yang lebih cepet kelar didengerin.
KOKORO_SPEED=1.0

# --- Piper (cuma kepakai kalau TTS_BACKEND=piper) ---
# PIPER_VOICE=models/en_US-lessac-medium.onnx

# --- Audio ---
SAMPLE_RATE=16000
# Rekaman lebih pendek dari ini dianggap salah pencet (detik)
MIN_RECORD_SECONDS=0.4
# Batas atas, biar hotkey yang kepencet nggak sengaja nggak ngerekam selamanya
MAX_RECORD_SECONDS=60
# Tenggang sebelum rekaman distop pas hotkey kedeteksi lepas. Windows sering ngirim
# UP/DOWN palsu selama tombol ditahan; naikin kalau rekaman masih kepotong-potong.
RELEASE_GRACE_SECONDS=0.6
# Bantalan hening di kedua ujung playback. Tanpa ini Windows motong ~100 ms di
# awal & akhir tiap suara. Naikin kalau masih kepotong di mesinmu.
PLAYBACK_PAD_SECONDS=0.2

# --- Kalender ---
# File .ics lokal yang dibaca DAN ditulisi agent. Ini satu-satunya sumber yang
# jalan pas OFFLINE_MODE=true.
CALENDAR_ICS_FILE=memory/kalender.ics
CALENDAR_TZ=Australia/Canberra
# Jendela rinci: tiap acara disebut satu per satu.
CALENDAR_DAYS_AHEAD=7
# Di luar jendela rinci, yang dikirim cuma acara yang MENYIMPANG dari pola
# mingguan (ujian, kelas pengganti, acara pribadi). Kelas rutin dilewat karena
# udah kewakili di atas. 0 = matiin.
CALENDAR_LOOKAHEAD_DAYS=90
CALENDAR_CACHE_MINUTES=60
CALENDAR_TIMEOUT=20

# --- Sumber kalender jaringan (DITOLAK kalau OFFLINE_MODE=true) ---
# RAHASIA — siapa pun yang punya URL ini bisa baca seluruh jadwalmu tanpa login.
# Ambil di: Google Calendar > Settings > "Secret address in iCal format",
# Outlook > Calendar > Share > Publish, atau MyTimetable ANU > Export/Subscribe.
CALENDAR_ICS_URL=
# Google Calendar (baca + tulis). Butuh login sekali: python scripts/login_google.py
GOOGLE_CREDENTIALS_FILE=

# Google Calendar mana yang dipakai (cuma kalau GOOGLE_CREDENTIALS_FILE diisi)
GOOGLE_CALENDAR_ID=primary

# --- Memori ---
MEMORY_ENABLED=true
# Tempat facts.md, history.json, tasks.json, dan kalender.ics
MEMORY_DIR=memory
# Biarin model nyaring sendiri fakta yang layak diinget dari tiap obrolan.
# Mati secara default: model kecil gampang nyimpen jadwal (yang udah punya
# sumber sendiri) dan sesekali ngehapus seluruh daftar.
MEMORY_AUTO_FACTS=false
FACTS_MAX_ITEMS=30
# Berapa giliran obrolan yang dibawa ke prompt berikutnya
MAX_HISTORY_MESSAGES=20
# Riwayat lebih tua dari ini nggak dimuat pas agent nyala. Sengaja pendek:
# obrolan kemarin bukan cuma nggak nolong, tapi bikin model ngarang soal data
# yang udah berubah — pernah kejadian dia ngaku udah mindahin deadline yang
# acaranya bahkan udah dihapus. Riwayat buat nyambung percakapan, bukan sumber
# fakta; sumbernya kalender & daftar tugas yang selalu terkini.
HISTORY_MAX_AGE_HOURS=4

# --- Log ---
LOG_FILE=logs/agent.log
LOG_LEVEL=INFO
# Simpan tiap rekaman mic ke logs/rec/*.wav buat nyetel akurasi STT.
# Matiin lagi kalau udah selesai — ini nyimpen rekaman suaramu ke disk.
SAVE_RECORDINGS=false
RECORDINGS_DIR=logs/rec
